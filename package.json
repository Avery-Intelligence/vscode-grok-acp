{
  "name": "vscode-grok-acp",
  "displayName": "Grok ACP Host (unofficial)",
  "description": "Open-source ACP host for the Grok Build CLI. Not affiliated with xAI.",
  "version": "0.2.2",
  "publisher": "humfrid",
  "license": "MIT",
  "private": false,
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:grokAcp.open"
  ],
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "require": "./out/index.js",
      "default": "./out/index.js"
    },
    "./extension": {
      "types": "./out/extension.d.ts",
      "require": "./out/extension.js",
      "default": "./out/extension.js"
    }
  },
  "files": [
    "out/**/*.js",
    "out/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "grokAcp.open",
        "title": "Grok ACP: Open Host (dev)"
      }
    ],
    "configuration": {
      "title": "Grok ACP Host",
      "properties": {
        "grokAcp.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the grok binary. Empty = PATH / ~/.grok/bin/grok."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/**/*.test.js",
    "check:boundary": "node scripts/check-boundary.mjs",
    "prepare": "npm run compile",
    "prepublishOnly": "npm run check:boundary && npm run compile",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.98.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Avery-Intelligence/vscode-grok-acp.git"
  },
  "bugs": {
    "url": "https://github.com/Avery-Intelligence/vscode-grok-acp/issues"
  },
  "homepage": "https://github.com/Avery-Intelligence/vscode-grok-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "grok",
    "vscode",
    "coding-agent"
  ]
}
